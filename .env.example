# Скопируйте в .env и задайте свои значения. Без .env используются демо-значения из compose.yaml.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=radar-demo-2026
# Токен, с которым Prometheus забирает /metrics (не короче 16 символов)
METRICS_TOKEN=change-me-metrics-token
DB_PASSWORD=change-me-db-password
# Пароль администратора Grafana (http://localhost:3000, логин admin)
GRAFANA_PASSWORD=change-me-grafana-password
# Секрет клиента OIDC — общий для api и dex
OIDC_CLIENT_SECRET=change-me-oidc-secret
# Telegram-бот (необязательно): токен от @BotFather и код подключения (/start <код>, не короче 8 символов)
TELEGRAM_BOT_TOKEN=
TELEGRAM_LINK_CODE=
# Час утреннего плана по Москве (0–23) или off
TELEGRAM_DIGEST_HOUR=9
# ИИ-помощник (необязательно): yandex | gigachat | openai | off. Email клиентов модели не передаются.
# OpenAI: AI_API_KEY — ключ sk-… с platform.openai.com; AI_BASE_URL — для совместимых сервисов (OpenRouter, Ollama);
#         AI_PROXY — исходящий прокси, если OpenAI недоступен из страны сервера (например, http://host:port).
# YandexGPT: AI_API_KEY — API-ключ сервисного аккаунта с ролью ai.languageModels.user, AI_FOLDER_ID — ID каталога.
# GigaChat: AI_API_KEY — ключ авторизации из личного кабинета (Basic), AI_SCOPE — GIGACHAT_API_PERS,
#           AI_CA_BUNDLE — путь к сертификату НУЦ Минцифры, если его нет в системе.
AI_PROVIDER=off
AI_API_KEY=
AI_FOLDER_ID=
AI_MODEL=
AI_BASE_URL=
AI_PROXY=
